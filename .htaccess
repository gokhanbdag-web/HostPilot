<IfModule mod_rewrite.c>
    RewriteEngine On

    # Preserve Authorization for PHP environments that otherwise drop it.
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Block repository internals and private application directories.
    RewriteRule ^(?:\.git|\.github|app|bootstrap|config|database|docs|resources|routes|tests|storage)(/|$) - [F,L,NC]

    # Do not publish repository metadata or developer documentation.
    RewriteRule ^(?:README\.md|UPDATE_NOTES\.md|DEVELOPMENT-STATUS\.md|ROADMAP\.md|VERSION)$ - [F,L,NC]

    # Existing files/directories (assets, installer entry point) are served normally.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Route application requests through the front controller.
    RewriteRule ^ index.php [QSA,L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

