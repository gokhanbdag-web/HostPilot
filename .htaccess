<IfModule mod_rewrite.c>
    RewriteEngine On

    # Preserve Authorization for PHP environments that otherwise drop it.
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Block direct access to internal application and storage directories.
    RewriteRule ^(app|bootstrap|config|database|resources|routes|tests|storage)(/|$) - [F,L,NC]

    # Existing files/directories (assets, installer entry point) are served normally.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Route application requests through the front controller.
    RewriteRule ^ index.php [QSA,L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

